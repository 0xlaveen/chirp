{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chirp",
  "version": "0.1.0",
  "identifier": "dev.chirp.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Chirp", "width": 760, "height": 650, "minWidth": 480, "minHeight": 500 },
      { "label": "hud", "title": "Chirp dictation", "url": "index.html?hud", "width": 440, "height": 160, "visible": false, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "focus": false, "resizable": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["deb", "rpm"], "icon": ["icons/icon.png"], "category": "Utility", "shortDescription": "Private dictation", "linux": { "deb": { "depends": ["xdotool", "xclip"] } } }
}
