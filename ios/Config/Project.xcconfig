// Override with xcodebuild settings or an untracked Config/Local.xcconfig.
CHIRP_BUNDLE_ID = dev.chirp.ios
CHIRP_APP_GROUP = group.dev.chirp.ios
CHIRP_KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(CHIRP_BUNDLE_ID).shared
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_BITCODE = NO
CLANG_ENABLE_MODULES = YES
#include? "Local.xcconfig"
